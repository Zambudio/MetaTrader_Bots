{
  "name": "trading-agents-dashboard-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env start.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "validate:baselines": "tsx --env-file-if-exists=.env scripts/validateBaselines.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3",
    "vitest": "^4.1.11"
  }
}
