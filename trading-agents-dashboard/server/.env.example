PORT=5175

# OmniRoute (self-hosted AI gateway en el NAS) — si se dejan vacíos, el backend
# usa el ejecutor simulado (mockExecutor.ts) sin llamar a ningún LLM real.
OMNIROUTE_BASE_URL=http://192.168.1.3:20128
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=auto/best-reasoning

# Twelve Data (forex/materias primas) — opcional, deja vacío para usar solo cripto (Kraken, sin key)
TWELVEDATA_API_KEY=

# Ruta a metaeditor64.exe — opcional, por defecto usa la ruta estándar de instalación de
# MetaTrader 5 en Windows. Si no se encuentra el ejecutable, la generación de código MQL5 sigue
# funcionando pero sin verificar la compilación (compileStatus: 'unverified').
METAEDITOR_PATH=C:\Program Files\MetaTrader 5\metaeditor64.exe
