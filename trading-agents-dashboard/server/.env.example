PORT=5175

# OmniRoute (self-hosted AI gateway en el NAS) — si se dejan vacíos, el backend
# usa el ejecutor simulado (mockExecutor.ts) sin llamar a ningún LLM real.
OMNIROUTE_BASE_URL=http://192.168.1.3:20128
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=auto/best-reasoning

# Fuentes de LLM por CLI de suscripción (Agent.model = "claude:sonnet", "openai:gpt-5.6-sol:high"…).
# NO definir ANTHROPIC_API_KEY ni OPENAI_API_KEY: los CLIs `claude` y `codex` deben usar la
# autenticación de SUSCRIPCIÓN (~/.claude, ~/.codex), no facturar por API por token.
# Rutas de los CLIs — opcionales, se autodetectan (claude.exe en ~/.local/bin, codex en %APPDATA%\npm).
# CLAUDE_CLI_BIN=C:\Users\<user>\.local\bin\claude.exe
# CODEX_CLI_JS=C:\Users\<user>\AppData\Roaming\npm\node_modules\@openai\codex\bin\codex.js

# Agentes de un mismo nivel del grafo que se ejecutan a la vez (def. 5).
# AGENT_MAX_CONCURRENCY=5

# Tiempo máximo (ms) para UNA llamada a un CLI de agente de análisis (`claude -p`, `codex exec`).
# Def. 180000 (claude) / 240000 (codex). Súbelo si los revisores (riesgo/crítico), que reciben
# toda la cadena de contexto + snapshot + estrategia, se cortan con "[claudeCli] timeout (180s)".
# AGENT_CLI_TIMEOUT_MS=420000

# Reintentos ante fallos TRANSITORIOS de un CLI de agente (salida rápida con código 1 y stderr
# vacío, stdout no parseable, subtype != success). Def. 2, tope 5. Los timeouts NO se reintentan.
# AGENT_CLI_RETRIES=2

# Tiempo máximo (ms) para UNA llamada al LLM que escribe/corrige el .mq5 (def. 300000 = 5 min).
# Súbelo si usas un modelo por CLI lento (claude/codex) y ves timeouts a mitad de generación.
# MQL5_GEN_TIMEOUT_MS=300000

# Twelve Data (forex/materias primas) — opcional, deja vacío para usar solo cripto (Kraken, sin key)
TWELVEDATA_API_KEY=

# Ruta a metaeditor64.exe — opcional, por defecto usa la ruta estándar de instalación de
# MetaTrader 5 en Windows. Si no se encuentra el ejecutable, la generación de código MQL5 sigue
# funcionando pero sin verificar la compilación (compileStatus: 'unverified').
METAEDITOR_PATH=C:\Program Files\MetaTrader 5\metaeditor64.exe
