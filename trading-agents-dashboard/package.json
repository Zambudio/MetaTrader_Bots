{
  "name": "trading-agents-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"vite\" \"npm run dev --prefix server\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "start": "npm run start --prefix server",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "lightweight-charts": "^5.2.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "technicalindicators": "^3.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
